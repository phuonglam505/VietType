// App icon (resource ID 1 = default app icon)
1 ICON "v.ico"
// Vietnamese mode icon
101 ICON "v.ico"
// English mode icon
102 ICON "e.ico"

// UAC manifest: start with the caller's privileges.
1 24 "viettype.manifest"

1 VERSIONINFO
 FILEVERSION 2027,1,0,0
 PRODUCTVERSION 2027,1,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "VietType Vietnamese Input Method\0"
            VALUE "FileVersion", "2027.1.0.0\0"
            VALUE "OriginalFilename", "VietType.exe\0"
            VALUE "ProductName", "VietType\0"
            VALUE "ProductVersion", "v2027.01\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
