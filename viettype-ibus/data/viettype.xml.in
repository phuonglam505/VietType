<?xml version="1.0" encoding="utf-8"?>
<component>
    <name>org.freedesktop.IBus.VietType</name>
    <description>VietType Vietnamese Input Method</description>
    <exec>@IBUS_LIBEXECDIR@/ibus-engine-viettype --ibus</exec>
    <version>@PROJECT_VERSION@</version>
    <author>VietType Project</author>
    <license>GPL-3.0-or-later</license>
    <homepage>https://github.com/phuonglam505/VietType</homepage>
    <textdomain>viettype-ibus</textdomain>
    <engines>
        <engine>
            <name>viettype</name>
            <language>vi</language>
            <license>GPL-3.0-or-later</license>
            <author>VietType Project</author>
            <icon>ibus-viettype</icon>
            <layout>us</layout>
            <longname>VietType Vietnamese</longname>
            <description>Vietnamese input method (Telex, VNI, VIQR) with charset support</description>
            <rank>99</rank>
            <symbol>Vi</symbol>
        </engine>
    </engines>
</component>
